# ============================================================
# Production environment — Sistem Management Kos (Ploi)
# Salin nilai-nilai ini ke editor ".env" pada panel Ploi,
# lalu isi yang bertanda <…>. JANGAN commit .env asli.
# ============================================================

APP_NAME="Kos Management"
APP_ENV=production
APP_KEY=                      # isi via: php artisan key:generate --force (atau Ploi)
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://<domain-anda>
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (PostgreSQL yang dibuat di Ploi) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<nama_db>
DB_USERNAME=<user_db>
DB_PASSWORD=<password_db>

# --- Redis (cache, session, queue) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --- Email (untuk reminder via Email) ---
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-pass>
MAIL_FROM_ADDRESS="kos@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# --- WhatsApp (Fonnte / gateway HTTP generik) ---
WHATSAPP_DRIVER=fonnte
WHATSAPP_TOKEN=<token-fonnte>
WHATSAPP_ENDPOINT=https://api.fonnte.com/send

# --- Penjadwalan tagihan ---
KOS_BILLING_DAY=1            # tanggal generate tagihan bulanan (1 = tanggal 1)
KOS_GENERATE_DAYS_AHEAD=7    # generate invoice berapa hari sebelum periode mulai
